# .env.example — copy to .env and fill in values before running docker compose
# All passwords shown here are placeholders. Change before use.
APP_DB_PASSWORD=change_me_app
KC_DB_PASSWORD=change_me_kc
KC_ADMIN_PASSWORD=change_me_admin
KC_ADMIN_CLIENT_SECRET=dev-admin-secret

# Frontend base URL — used in password reset emails and other links
FRONTEND_BASE_URL=http://localhost:5173
