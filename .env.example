# .env.example — copy to .env and fill in values before running docker compose
# All passwords shown here are placeholders. Change before use.
APP_DB_PASSWORD=change_me_app
KC_DB_PASSWORD=change_me_kc
KC_ADMIN_PASSWORD=change_me_admin
KC_ADMIN_CLIENT_SECRET=dev-admin-secret

# Frontend base URL — used in password reset emails and other links
FRONTEND_BASE_URL=http://localhost:5173

# Admin Backoffice — seeded admin user for backoffice login
# Created in onboarding-realm.json with realm role "admin"
ADMIN_SEED_EMAIL=admin@onboarding.local
ADMIN_SEED_PASSWORD=Admin@123!

# Keycloak realm — consumed by auth-server.ts in both SPAs.
# Supported values: "client" | "backoffice". The legacy realm "onboarding" no longer
# exists (removed in Phase 34). Passing "onboarding" causes an immediate startup error.
#
# When running via docker compose, each SPA container receives the correct value
# automatically (compose.yaml sets KEYCLOAK_REALM=client / KEYCLOAK_REALM=backoffice).
#
# When running outside compose (e.g. `pnpm dev`), set the value matching the SPA:
#   for frontend/client  → KEYCLOAK_REALM=client
#   for frontend/backoffice → KEYCLOAK_REALM=backoffice
# Both SPAs default to their own realm name when KEYCLOAK_REALM is not set, so
# `pnpm dev` on a fresh checkout works without a .env file.
#
# KEYCLOAK_REALM=client       # for frontend/client
# KEYCLOAK_REALM=backoffice   # for frontend/backoffice (run with a separate .env)
